var LS_LOGS     = "hp_logs_v1";
var LS_HISTORY  = "hp_history_v1";
var LS_OPTIONAL = "hp_optional_v1";
var LS_THEME    = "hp_theme_v1";
var LS_PRS      = "hp_prs_v1";
var LS_NOTES    = "hp_notes_v1";

function makeKey(di, si, ei) { return di + "-" + si + "-" + ei; }
function todayLabel() { return new Date().toLocaleDateString("en-US", { weekday:"long", year:"numeric", month:"long", day:"numeric" }); }
function todayISO() { return new Date().toISOString().slice(0, 10); }
function isComplete(sl) { return sl.length > 0 && sl.every(function(s) { return s.weight !== "" && s.reps !== ""; }); }

function lsGet(key) {
  try { var v = localStorage.getItem(key); return v ? JSON.parse(v) : null; } catch(e) { return null; }
}
function lsSet(key, val) {
  try { localStorage.setItem(key, JSON.stringify(val)); return true; } catch(e) { return false; }
}

function calc1RM(weight, reps) {
  if (!weight || !reps || reps < 1) return null;
  return Math.round(parseFloat(weight) * (1 + parseInt(reps) / 30));
}

function getLastSession(dayName) {
  var history = lsGet(LS_HISTORY) || [];
  var today = todayISO();
  var matches = history.filter(function(h) { return h.dayName === dayName && h.dateKey !== today; });
  matches.sort(function(a, b) { return b.dateKey.localeCompare(a.dateKey); });
  return matches[0] || null;
}

function getLastBest(dayName, exName) {
  var session = getLastSession(dayName);
  if (!session) return null;
  var ex = null;
  for (var i = 0; i < session.exercises.length; i++) {
    if (session.exercises[i].name === exName) { ex = session.exercises[i]; break; }
  }
  if (!ex || !ex.sets || !ex.sets.length) return null;
  var best = ex.sets[0];
  for (var j = 1; j < ex.sets.length; j++) {
    if ((parseFloat(ex.sets[j].weight) || 0) > (parseFloat(best.weight) || 0)) best = ex.sets[j];
  }
  return best;
}

function getOverloadSuggestion(dayName, exName) {
  var last = getLastBest(dayName, exName);
  if (!last || !last.weight || !last.reps) return null;
  var w = parseFloat(last.weight);
  var r = parseInt(last.reps);
  if (r >= 12) {
    var inc = w >= 100 ? 5 : 2.5;
    return { type: "increase", message: "You hit " + r + " reps last time - try " + (w + inc) + " lbs today" };
  }
  return { type: "maintain", message: "Aim for more reps at " + w + " lbs (last: " + r + " reps)" };
}

function getWeeklyVolume() {
  var history = lsGet(LS_HISTORY) || [];
  var now = new Date();
  var weekStart = new Date(now);
  weekStart.setDate(now.getDate() - now.getDay());
  weekStart.setHours(0, 0, 0, 0);
  var weekStartStr = weekStart.toISOString().slice(0, 10);
  var thisWeek = history.filter(function(h) { return h.dateKey >= weekStartStr; });
  var muscleVol = {};
  thisWeek.forEach(function(session) {
    session.exercises.forEach(function(ex) {
      if (ex.isPlank) return;
      var primary = (ex.muscles[0] || "Other").replace(/\s*\(.*?\)/, "").trim();
      muscleVol[primary] = (muscleVol[primary] || 0) + ex.totalVolume;
    });
  });
  return muscleVol;
}

function getStreak() {
  var history = lsGet(LS_HISTORY) || [];
  if (!history.length) return 0;
  var weeks = {};
  history.forEach(function(h) {
    var d = new Date(h.dateKey + "T12:00:00");
    var day = d.getDay();
    var sunday = new Date(d);
    sunday.setDate(d.getDate() - day);
    weeks[sunday.toISOString().slice(0, 10)] = true;
  });
  var now = new Date();
  var thisSunday = new Date(now);
  thisSunday.setDate(now.getDate() - now.getDay());
  thisSunday.setHours(0, 0, 0, 0);
  var streak = 0;
  var checkDate = new Date(thisSunday);
  for (var i = 0; i < 52; i++) {
    var key = checkDate.toISOString().slice(0, 10);
    if (weeks[key]) {
      streak++;
      checkDate.setDate(checkDate.getDate() - 7);
    } else {
      if (i === 0) { checkDate.setDate(checkDate.getDate() - 7); continue; }
      break;
    }
  }
  return streak;
}

function getPRs() { return lsGet(LS_PRS) || {}; }

function checkAndUpdatePR(exName, weight, reps) {
  if (!weight || !reps) return false;
  var prs = getPRs();
  var w = parseFloat(weight);
  var r = parseInt(reps);
  var est1RM = Math.round(w * (1 + r / 30));
  var prev = prs[exName];
  if (!prev || est1RM > prev.est1RM) {
    prs[exName] = { weight: w, reps: r, est1RM: est1RM, date: todayISO() };
    lsSet(LS_PRS, prs);
    return true;
  }
  return false;
}

function getMuscleRecovery() {
  var history = lsGet(LS_HISTORY) || [];
  var now = new Date();
  var muscleMap = {
    "Chest": ["Chest", "Upper Chest", "Lower Chest", "Inner Chest"],
    "Triceps": ["Triceps"],
    "Shoulders": ["Deltoid", "Anterior", "Medial"],
    "Back": ["Lats", "Rhomboids", "Teres", "Serratus", "Mid-Back", "Erector"],
    "Biceps": ["Biceps", "Brachialis", "Brachioradialis"],
    "Core": ["Obliques", "Rectus Abdominis", "Core", "Abs"],
    "Quads": ["Quads"],
    "Hamstrings": ["Hamstrings"],
    "Glutes": ["Glutes"],
    "Forearms": ["Forearms"],
  };
  var recovery = {};
  Object.keys(muscleMap).forEach(function(muscle) {
    var mostRecent = null;
    history.forEach(function(session) {
      (session.exercises || []).forEach(function(ex) {
        var matchesMuscle = (ex.muscles || []).some(function(m) {
          return muscleMap[muscle].some(function(keyword) { return m.indexOf(keyword) !== -1; });
        });
        if (matchesMuscle) {
          var d = new Date(session.dateKey + "T12:00:00");
          if (!mostRecent || d > mostRecent) mostRecent = d;
        }
      });
    });
    if (!mostRecent) { recovery[muscle] = null; return; }
    recovery[muscle] = Math.round((now - mostRecent) / (1000 * 60 * 60));
  });
  return recovery;
}

function buildSession(logs, di, optLogs) {
  var d = DAYS[di];
  var exercises = [];
  d.supersets.forEach(function(ss, si) {
    ss.exercises.forEach(function(ex, ei) {
      var sl = logs[makeKey(di, si, ei)] || [];
      var filled = sl.filter(function(s) { return s.weight || s.reps; });
      if (!filled.length) return;
      var totalVol = filled.reduce(function(a, s) { return a + (parseFloat(s.weight) || 0) * (parseInt(s.reps) || 0); }, 0);
      exercises.push({
        name: ex.name,
        muscles: ex.muscles,
        sets: filled.map(function(s, idx) { return { set: idx + 1, weight: s.weight, reps: s.reps }; }),
        completed: isComplete(sl),
        totalVolume: totalVol,
      });
    });
  });
  if (optLogs) {
    var swings = (optLogs[di + "-swings"] || []).filter(function(s) { return s.weight || s.reps; });
    if (swings.length) {
      exercises.push({
        name: "Kettlebell Swing (Bonus)", muscles: ["Glutes (Primary)", "Hamstrings", "Core"],
        sets: swings.map(function(s, i) { return { set: i + 1, weight: s.weight, reps: s.reps }; }),
        completed: swings.every(function(s) { return s.weight && s.reps; }),
        totalVolume: swings.reduce(function(a, s) { return a + (parseFloat(s.weight) || 0) * (parseInt(s.reps) || 0); }, 0),
      });
    }
    if (twists.length) {
      exercises.push({
        name: "DB Russian Twist (Bonus)", muscles: ["Obliques (Primary)", "Rectus Abdominis", "Hip Flexors"],
        sets: twists.map(function(s, i) { return { set: i + 1, weight: s.weight, reps: s.reps }; }),
        completed: twists.every(function(s) { return s.weight && s.reps; }),
        totalVolume: twists.reduce(function(a, s) { return a + (parseFloat(s.weight) || 0) * (parseInt(s.reps) || 0); }, 0),
      });
    }
    if (planks.length) {
      exercises.push({
        name: "Forearm Plank (Bonus)", muscles: ["Core Stabilizers", "Obliques"], isPlank: true,
        sets: planks.map(function(s, i) { return { set: i + 1, weight: "", reps: s.time + "s hold" }; }),
        completed: planks.every(function(s) { return s.time; }),
        totalVolume: 0,
        totalTime: planks.reduce(function(a, s) { return a + (parseInt(s.time) || 0); }, 0),
      });
    }
  }
  if (!exercises.length) return null;
  return {
    date: todayLabel(), dateKey: todayISO(),
    dayName: d.day, focus: d.focus, tag: d.tag, color: d.color,
    exercises: exercises,
    totalVolume: exercises.reduce(function(a, e) { return a + e.totalVolume; }, 0),
  };
}

function saveSessionToHistory(logs, dayIndex, optLogs, notes) {
  var session = buildSession(logs, dayIndex, optLogs);
  if (!session) return;
  // Attach any session note
  if (notes) {
    var noteKey = todayISO() + "-" + dayIndex;
    var note = notes[noteKey];
    if (note) session.note = note;
  }
  var existing = lsGet(LS_HISTORY) || [];
  var idx = -1;
  for (var i = 0; i < existing.length; i++) {
    if (existing[i].dateKey === session.dateKey && existing[i].dayName === session.dayName) { idx = i; break; }
  }
  if (idx >= 0) {
    var prevEx = JSON.stringify(existing[idx].exercises);
    var prevNote = existing[idx].note || "";
    if (prevEx === JSON.stringify(session.exercises) && prevNote === (session.note || "")) return;
    existing[idx] = session;
  } else {
    existing.unshift(session);
  }
  lsSet(LS_HISTORY, existing);
}

