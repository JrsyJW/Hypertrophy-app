// ---- RECOVERY HEATMAP ----
function RecoveryHeatmap(props) {
  var isDark = props.isDark;
  var liveLogs = props.liveLogs || {};
  var cardBg = isDark ? "#111" : "#ebebeb";
  var borderCol = isDark ? "#1e1e1e" : "#ddd";
  var textMain = isDark ? "#eee" : "#111";
  var textSub = isDark ? "#999" : "#555";

  // Build recovery from history AND merge live logs for today
  var muscleMap = {
    "Chest":      ["Chest", "Upper Chest", "Lower Chest", "Inner Chest"],
    "Triceps":    ["Triceps"],
    "Shoulders":  ["Deltoid", "Anterior", "Medial"],
    "Back":       ["Lats", "Rhomboids", "Teres", "Serratus", "Mid-Back", "Erector"],
    "Biceps":     ["Biceps", "Brachialis", "Brachioradialis"],
    "Core":       ["Obliques", "Rectus Abdominis", "Core", "Abs"],
    "Quads":      ["Quads"],
    "Hamstrings": ["Hamstrings"],
    "Glutes":     ["Glutes"],
    "Forearms":   ["Forearms"],
  };

  var history = lsGet(LS_HISTORY) || [];
  var now = new Date();
  var todayStr = todayISO();

  // Build a merged list: committed history + any live data logged today
  var liveExercises = [];
  DAYS.forEach(function(day, di) {
    day.supersets.forEach(function(ss, si) {
      ss.exercises.forEach(function(ex, ei) {
        var key = makeKey(di, si, ei);
        var sl = liveLogs[key] || [];
        var hasData = sl.some(function(s) { return s.weight || s.reps; });
        if (hasData) {
          liveExercises.push({ muscles: ex.muscles });
        }
      });
    });
  });

  var recovery = {};
  Object.keys(muscleMap).forEach(function(muscle) {
    var mostRecent = null;

    // Check committed history
    history.forEach(function(session) {
      (session.exercises || []).forEach(function(ex) {
        var match = (ex.muscles || []).some(function(m) {
          return muscleMap[muscle].some(function(k) { return m.indexOf(k) !== -1; });
        });
        if (match) {
          var d = new Date(session.dateKey + "T12:00:00");
          if (!mostRecent || d > mostRecent) mostRecent = d;
        }
      });
    });

    // Check live logs (today's unsaved data) — treat as trained right now
    var trainedLiveToday = liveExercises.some(function(ex) {
      return (ex.muscles || []).some(function(m) {
        return muscleMap[muscle].some(function(k) { return m.indexOf(k) !== -1; });
      });
    });
    if (trainedLiveToday) {
      mostRecent = now; // just trained
    }

    if (!mostRecent) { recovery[muscle] = null; return; }
    recovery[muscle] = Math.max(0, Math.round((now - mostRecent) / (1000 * 60 * 60)));
  });

  function getStatus(hours) {
    if (hours === null) return { label:"Not yet trained", color:"#555", bg: isDark ? "#1a1a1a" : "#e0e0e0", bar:"0%" };
    if (hours < 24)  return { label:hours+"h ago  -  Recovering", color:"#E8453C", bg:"#E8453C18", bar:Math.round((hours/24)*100)+"%" };
    if (hours < 48)  return { label:hours+"h ago  -  Resting",    color:"#F5A623", bg:"#F5A62318", bar:Math.round(((hours-24)/24)*100)+"%" };
    return             { label:hours+"h ago  -  Ready",            color:"#22c55e", bg:"#22c55e18", bar:"100%" };
  }

  return (
    <div style={{ marginTop:16, background:cardBg, border:"1px solid "+borderCol, borderRadius:8, padding:16 }}>
      <div style={{ fontFamily:"monospace", fontSize:10, color:textSub, letterSpacing:"0.12em", marginBottom:12 }}>MUSCLE RECOVERY STATUS</div>
      <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fill,minmax(160px,1fr))", gap:8 }}>
        {Object.keys(muscleMap).map(function(muscle) {
          var hours = recovery[muscle];
          var st = getStatus(hours);
          return (
            <div key={muscle} style={{ background:st.bg, border:"1px solid "+st.color+"33", borderRadius:6, padding:"8px 10px" }}>
              <div style={{ fontSize:12, fontWeight:700, color:textMain, marginBottom:3 }}>{muscle}</div>
              <div style={{ fontFamily:"monospace", fontSize:9, color:st.color, marginBottom:5 }}>{st.label}</div>
              <div style={{ height:3, borderRadius:2, background: isDark ? "#222" : "#ccc" }}>
                <div style={{ height:"100%", borderRadius:2, background:st.color, width:st.bar }}/>
              </div>
            </div>
          );
        })}
      </div>
      <div style={{ display:"flex", gap:16, marginTop:12, flexWrap:"wrap" }}>
        {[["#E8453C","< 24h  Recovering"],["#F5A623","24-48h  Resting"],["#22c55e","48h+  Ready"]].map(function(pair) {
          return (
            <div key={pair[0]} style={{ display:"flex", alignItems:"center", gap:6 }}>
              <div style={{ width:10, height:10, borderRadius:2, background:pair[0] }}/>
              <span style={{ fontFamily:"monospace", fontSize:9, color:textSub }}>{pair[1]}</span>
            </div>
          );
        })}
      </div>
    </div>
  );
}

// ---- AUDIO & REST TIMER ----
function getAudioCtx() {
  if (!window._audioCtx) {
    window._audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  }
  return window._audioCtx;
}

function speakNumber(n) {
  if (!window.speechSynthesis) return;
  window.speechSynthesis.cancel();
  var u = new SpeechSynthesisUtterance(String(n));
  u.rate = 1.1; u.pitch = 1; u.volume = 1;
  window.speechSynthesis.speak(u);
}

function ringBell(ctx) {
  var now = ctx.currentTime;
  [[440,1],[880,0.5],[1320,0.3],[1760,0.15]].forEach(function(pair) {
    var freq = pair[0]; var gain = pair[1];
    var osc = ctx.createOscillator();
    var env = ctx.createGain();
    osc.connect(env); env.connect(ctx.destination);
    osc.type = "sine"; osc.frequency.setValueAtTime(freq, now);
    env.gain.setValueAtTime(gain, now);
    env.gain.exponentialRampToValueAtTime(0.001, now + 2.5);
    osc.start(now); osc.stop(now + 2.5);
  });
}

function RestTimer(props) {
  var color = props.color;
  var isDark = props.isDark;
  var [total, setTotal] = useState(0);
  var [remaining, setRemaining] = useState(0);
  var [running, setRunning] = useState(false);
  var [visible, setVisible] = useState(false);
  var [done, setDone] = useState(false);
  var intervalRef = useRef(null);
  var bellRef = useRef(null);
  var spokenRef = useRef({});
  var R = 10; var CIRC = 2 * Math.PI * R;

  function stopBell() { clearInterval(bellRef.current); bellRef.current = null; }

  function start(secs) {
    var ctx = getAudioCtx();
    if (ctx.state === "suspended") ctx.resume();
    clearInterval(intervalRef.current);
    stopBell();
    if (window.speechSynthesis) window.speechSynthesis.cancel();
    spokenRef.current = {};
    setTotal(secs); setRemaining(secs); setRunning(true); setVisible(true); setDone(false);
  }

  function cancel() {
    clearInterval(intervalRef.current);
    stopBell();
    if (window.speechSynthesis) window.speechSynthesis.cancel();
    setRunning(false); setDone(false); setTotal(0); setRemaining(0); setVisible(false);
  }

  useEffect(function() {
    if (!running) return;
    intervalRef.current = setInterval(function() {
      setRemaining(function(prev) {
        var next = prev - 1;
        if (next >= 1 && next <= 5 && !spokenRef.current[next]) {
          spokenRef.current[next] = true;
          speakNumber(next);
        }
        if (next <= 0) {
          clearInterval(intervalRef.current);
          setRunning(false); setDone(true);
          var ctx = getAudioCtx();
          ringBell(ctx);
          bellRef.current = setInterval(function() { ringBell(ctx); }, 2600);
          setTimeout(function() { speakNumber("Go"); }, 400);
          return 0;
        }
        return next;
      });
    }, 1000);
    return function() { clearInterval(intervalRef.current); };
  }, [running]);

  useEffect(function() { return function() { stopBell(); }; }, []);

  var accentColor = done ? "#22c55e" : color;
  var isCountdown = remaining <= 5 && remaining > 0 && running;
  var dash = CIRC * (total > 0 ? remaining / total : 1);
  var pillBorder = done ? "#22c55e88" : isCountdown ? "#ff6b0088" : visible ? accentColor + "55" : (isDark ? "#252525" : "#ccc");
  var pillShadow = done ? "0 4px 28px #22c55e44" : isCountdown ? "0 4px 28px #ff6b0066" : visible ? "0 4px 28px " + accentColor + "33" : "0 4px 16px rgba(0,0,0,0.3)";

  return (
