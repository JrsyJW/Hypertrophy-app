                    <div onClick={function() { setExpandedEx(open ? null : key); }} style={{ display:"flex", alignItems:"center", padding:"14px 16px", cursor:"pointer", gap:12 }}>
                      <div style={{ minWidth:28, height:28, borderRadius:"50%", background:done?"#22c55e22":day.color+"22", border:"1px solid "+(done?"#22c55e66":day.color+"44"), display:"flex", alignItems:"center", justifyContent:"center", fontFamily:"monospace", fontSize:done?14:11, color:done?"#22c55e":day.color, fontWeight:700 }}>
                        {done ? "✓" : si*2+ei+1}
                      </div>
                      <div style={{ flex:1 }}>
                        <div style={{ display:"flex", alignItems:"center", gap:8, marginBottom:4, flexWrap:"wrap" }}>
                          <span style={{ fontWeight:600, fontSize:15, color:done?"#22c55e":T.text }}>{ex.name}</span>
                          {done && <span style={{ fontFamily:"monospace", fontSize:9, color:"#22c55e", background:"#22c55e18", border:"1px solid #22c55e33", borderRadius:3, padding:"1px 6px" }}>COMPLETE</span>}
                          {!done && hasLog && <span style={{ fontFamily:"monospace", fontSize:9, color:day.color, opacity:.7 }}>IN PROGRESS</span>}
                        </div>
                        <div style={{ display:"flex", gap:6, flexWrap:"wrap" }}>
                          {ex.muscles.slice(0,3).map(function(m, mi) {
                            return <span key={mi} style={{ fontSize:11, color:T.sub }}>{m}{mi < Math.min(ex.muscles.length,3)-1 ? " ·" : ""}</span>;
                          })}
                        </div>
                      </div>
                      <div style={{ fontFamily:"monospace", fontSize:12, color:done?"#22c55e":day.color, fontWeight:700, minWidth:60, textAlign:"right" }}>{ex.sets}</div>
                      <button style={{ background:"none", border:"none", color:T.muted, cursor:"pointer", fontSize:20, padding:"0 0 0 8px", lineHeight:1 }}>{open?"−":"+"}</button>
                    </div>

                    {open && (
                      <div style={{ borderTop:"1px solid "+(done?"#22c55e22":T.border), padding:16, display:"grid", gap:16 }}>
                        <div>
                          <div style={{ fontFamily:"monospace", fontSize:10, color:T.muted, marginBottom:6 }}>ALL MUSCLES</div>
                          <div style={{ display:"flex", gap:6, flexWrap:"wrap" }}>
                            {ex.muscles.map(function(m, mi) {
                              return <span key={mi} style={{ fontSize:11, color:T.sub, background:T.section, border:"1px solid "+T.border, borderRadius:3, padding:"3px 8px" }}>{m}</span>;
                            })}
                          </div>
                        </div>
                        <div>
                          <div style={{ fontFamily:"monospace", fontSize:10, color:T.muted, marginBottom:5 }}>EQUIPMENT</div>
                          <div style={{ fontSize:13, color:T.sub }}>{ex.equipment}</div>
                        </div>
                        <div>
                          <div style={{ fontFamily:"monospace", fontSize:10, color:day.color, marginBottom:5 }}>WHY THIS EXERCISE</div>
                          <div style={{ fontSize:13, color:T.sub, lineHeight:1.65 }}>{ex.why}</div>
                        </div>
                        {ex.vid && (
                          <a href={"https://www.youtube.com/watch?v="+ex.vid} target="_blank" rel="noopener noreferrer"
                            style={{ display:"inline-flex", alignItems:"center", gap:8, background:"#ff000018", border:"1px solid #ff000044", borderRadius:6, padding:"8px 14px", textDecoration:"none" }}>
                            <svg width={16} height={16} viewBox="0 0 24 24" fill="#ff3333"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-2.75 12.64 12.64 0 0 0-8.07 0A4.83 4.83 0 0 1 4.41 6.69 49.13 49.13 0 0 0 4 12a49.13 49.13 0 0 0 .41 5.31 4.83 4.83 0 0 1 3.74 2.75 12.64 12.64 0 0 0 8.07 0 4.83 4.83 0 0 1 3.77-2.75A49.13 49.13 0 0 0 20 12a49.13 49.13 0 0 0-.41-5.31zM10 15V9l5 3-5 3z"/></svg>
                            <span style={{ fontFamily:"monospace", fontSize:10, color:"#ff5555", fontWeight:700 }}>WATCH TUTORIAL</span>
                          </a>
                        )}

                        {/* Last session + overload */}
                        {last && (
                          <div>
                            <div style={{ background:T.section, border:"1px solid "+day.color+"33", borderRadius:6, padding:"8px 12px", marginBottom:6, display:"flex", gap:16, flexWrap:"wrap", alignItems:"center" }}>
                              <div>
                                <div style={{ fontFamily:"monospace", fontSize:9, color:T.muted, marginBottom:2 }}>LAST SESSION</div>
                                <div style={{ fontFamily:"monospace", fontSize:13, color:day.color, fontWeight:700 }}>{last.weight} lbs x {last.reps} reps</div>
                              </div>
                              {calc1RM(last.weight, last.reps) && (
                                <div>
                                  <div style={{ fontFamily:"monospace", fontSize:9, color:T.muted, marginBottom:2 }}>EST. 1RM</div>
                                  <div style={{ fontFamily:"monospace", fontSize:13, color:T.sub, fontWeight:700 }}>{calc1RM(last.weight, last.reps)} lbs</div>
                                </div>
                              )}
                              <div style={{ fontFamily:"monospace", fontSize:9, color:T.faint, marginLeft:"auto" }}>BEAT THIS</div>
                            </div>
                            {suggest && (
                              <div style={{ background: suggest.type==="increase"?"#22c55e12":"#2D7FF912", border:"1px solid "+(suggest.type==="increase"?"#22c55e33":"#2D7FF933"), borderRadius:5, padding:"6px 12px", display:"flex", alignItems:"center", gap:8 }}>
                                <span style={{ fontSize:14 }}>{suggest.type==="increase"?"📈":"🎯"}</span>
                                <span style={{ fontFamily:"monospace", fontSize:10, color:suggest.type==="increase"?"#22c55e":"#2D7FF9" }}>{suggest.message}</span>
                              </div>
                            )}
                          </div>
                        )}

                        {/* Set Tracker */}
                        <div style={{ borderTop:"1px solid "+T.border, paddingTop:14 }}>
                          <div style={{ display:"flex", alignItems:"center", gap:10, marginBottom:12, flexWrap:"wrap" }}>
                            <div style={{ fontFamily:"monospace", fontSize:10, color:done?"#22c55e":day.color }}>
                              SET TRACKER {done && <span style={{ opacity:.6 }}>-- ALL SETS COMPLETE</span>}
                            </div>
                            {ex.log && (
                              <div style={{ fontFamily:"monospace", fontSize:9, fontWeight:700, padding:"2px 8px", borderRadius:20, background:ex.log==="combined"?"#2D7FF922":"#F5A62322", border:"1px solid "+(ex.log==="combined"?"#2D7FF966":"#F5A62366"), color:ex.log==="combined"?"#2D7FF9":"#F5A623" }}>
                                {ex.log==="combined" ? "LOG COMBINED WEIGHT" : "LOG PER SIDE"}
                              </div>
                            )}
                          </div>
                          <div style={{ display:"grid", gridTemplateColumns:"52px 1fr 1fr", gap:"4px 8px", marginBottom:6 }}>
                            <div/>
                            <div style={{ fontFamily:"monospace", fontSize:9, color:T.muted, textAlign:"center" }}>{ex.log==="combined"?"WEIGHT - BOTH SIDES":ex.log==="per-side"?"WEIGHT - ONE SIDE":"WEIGHT (lbs)"}</div>
                            <div style={{ fontFamily:"monospace", fontSize:9, color:T.muted, textAlign:"center" }}>REPS</div>
                          </div>
                          {sl.map(function(s, setIdx) {
                            var setDone = s.weight !== "" && s.reps !== "";
                            var dc = done ? "#22c55e" : day.color;
                            return (
                              <div key={setIdx} style={{ display:"grid", gridTemplateColumns:"52px 1fr 1fr", gap:"4px 8px", marginBottom:6, alignItems:"center" }}>
                                <div style={{ fontFamily:"monospace", fontSize:10, color:setDone?"#22c55e":(s.weight||s.reps)?day.color:T.faint, textAlign:"right", paddingRight:8, display:"flex", alignItems:"center", justifyContent:"flex-end", gap:4 }}>
                                  {setDone && <span>✓</span>}<span>SET {setIdx+1}</span>
                                </div>
                                <input type="number" style={Object.assign({}, inpStyle, { borderColor: setDone ? "#22c55e33" : T.border })}
                                  inputMode="decimal" placeholder="--" value={s.weight}
                                  onClick={function(e) { e.stopPropagation(); }}
                                  onChange={function(e) { updateLog(key, setIdx, "weight", e.target.value, ex.name); }}/>
                                <input type="number" style={Object.assign({}, inpStyle, { borderColor: setDone ? "#22c55e33" : T.border })}
                                  inputMode="numeric" placeholder="--" value={s.reps}
                                  onClick={function(e) { e.stopPropagation(); }}
                                  onChange={function(e) { updateLog(key, setIdx, "reps", e.target.value, ex.name); }}/>
                              </div>
                            );
                          })}
                          {hasLog && (function() {
                            var filled = sl.filter(function(s) { return s.weight && s.reps; });
                            if (!filled.length) return null;
                            var vol = filled.reduce(function(a, s) { return a + (parseFloat(s.weight)||0)*(parseInt(s.reps)||0); }, 0);
                            var maxW = Math.max.apply(null, filled.map(function(s) { return parseFloat(s.weight)||0; }));
                            var bestSet = filled.reduce(function(b, s) { return (parseFloat(s.weight)||0)>(parseFloat(b.weight)||0)?s:b; }, filled[0]);
                            var orm = calc1RM(bestSet.weight, bestSet.reps);
                            var ac = done ? "#22c55e" : day.color;
                            var stats = [{ l:"TOTAL VOL", v:vol.toLocaleString()+" lbs" }, { l:"TOP WEIGHT", v:maxW+" lbs" }, { l:"SETS DONE", v:filled.length+"/"+ex.numSets }];
                            if (orm) stats.push({ l:"EST. 1RM", v:orm+" lbs" });
                            return (
                              <div style={{ marginTop:12, display:"flex", gap:10, flexWrap:"wrap" }}>
                                {stats.map(function(st, i) {
                                  return (
                                    <div key={i} style={{ background:ac+"0e", border:"1px solid "+ac+"22", borderRadius:5, padding:"6px 12px", textAlign:"center", flex:1, minWidth:80 }}>
                                      <div style={{ fontFamily:"monospace", fontSize:9, color:T.muted, marginBottom:2 }}>{st.l}</div>
                                      <div style={{ fontFamily:"monospace", fontSize:13, color:ac, fontWeight:700 }}>{st.v}</div>
                                    </div>
                                  );
                                })}
                              </div>
                            );
                          })()}
                        </div>
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          );
        })}

        {/* Optional Bonus Superset */}
        {(function() {
          var swingKey = activeDay + "-swings";
          var plankKey = activeDay + "-plank";
          var swingLog = getOptLog(swingKey);
          var plankLog = getOptLog(plankKey);
          var hasSwings = swingLog.some(function(s) { return s.weight || s.reps; });
          var hasPlanks = plankLog.some(function(s) { return s.time; });
          var hasAny = hasSwings || hasPlanks ;

          return (
            <div style={{ marginBottom:24 }}>
              <div style={{ display:"flex", alignItems:"center", gap:10, marginBottom:12 }}>
                <div style={{ height:1, width:20, background:T.borderMid, opacity:.6 }}/>
                <span style={{ fontFamily:"monospace", fontSize:10, color:T.muted }}>OPTIONAL BONUS SUPERSET</span>
                {hasAny && <span style={{ fontFamily:"monospace", fontSize:9, color:"#22c55e" }}>LOGGED</span>}
                <button onClick={function() { setOptExpanded(function(p) { return !p; }); }}
                  style={{ marginLeft:"auto", background:"transparent", border:"1px solid "+T.borderMid, borderRadius:4, color:T.muted, fontFamily:"monospace", fontSize:9, padding:"3px 10px", cursor:"pointer" }}>
                  {optExpanded ? "HIDE" : "SHOW"}
                </button>
              </div>

              {optExpanded && (
                <div>
                  {/* KB Swings */}
                  <div style={{ background:hasSwings?(isDark?"#0a120e":"#efffef"):T.card, border:"1px solid "+(hasSwings?"#22c55e44":T.border), borderRadius:8, marginBottom:8, padding:"14px 16px" }}>
                    <div style={{ display:"flex", alignItems:"center", gap:12, marginBottom:12 }}>
                      <div style={{ minWidth:28, height:28, borderRadius:"50%", background:"#F5A62322", border:"1px solid #F5A62344", display:"flex", alignItems:"center", justifyContent:"center", fontFamily:"monospace", fontSize:11, color:"#F5A623", fontWeight:700 }}>KB</div>
                      <div>
                        <div style={{ fontWeight:600, fontSize:15, color:hasSwings?"#22c55e":T.text }}>Kettlebell Swing</div>
                        <div style={{ fontSize:11, color:T.sub }}>Glutes (Primary) · Hamstrings · Core</div>
                      </div>
                      <div style={{ marginLeft:"auto", fontFamily:"monospace", fontSize:9, color:"#F5A623", background:"#F5A62311", border:"1px solid #F5A62333", borderRadius:20, padding:"2px 8px" }}>LOG COMBINED</div>
                    </div>
                    <div style={{ display:"grid", gridTemplateColumns:"52px 1fr 1fr", gap:"4px 8px", marginBottom:6 }}>
                      <div/><div style={{ fontFamily:"monospace", fontSize:9, color:T.muted, textAlign:"center" }}>WEIGHT (lbs)</div><div style={{ fontFamily:"monospace", fontSize:9, color:T.muted, textAlign:"center" }}>REPS</div>
                    </div>
                    {[0,1,2].map(function(setIdx) {
                      var s = swingLog[setIdx] || { weight:"", reps:"" };
                      var setDone = s.weight && s.reps;
                      return (
                        <div key={setIdx} style={{ display:"grid", gridTemplateColumns:"52px 1fr 1fr", gap:"4px 8px", marginBottom:6, alignItems:"center" }}>
                          <div style={{ fontFamily:"monospace", fontSize:10, color:setDone?"#22c55e":"#F5A623", textAlign:"right", paddingRight:8 }}>SET {setIdx+1}</div>
                          <input type="number" style={Object.assign({}, inpStyle, { borderColor:setDone?"#22c55e33":T.border })} inputMode="decimal" placeholder="--" value={s.weight||""} onChange={function(e) { updateOptLog(swingKey, setIdx, "weight", e.target.value); }}/>
                          <input type="number" style={Object.assign({}, inpStyle, { borderColor:setDone?"#22c55e33":T.border })} inputMode="numeric" placeholder="--" value={s.reps||""} onChange={function(e) { updateOptLog(swingKey, setIdx, "reps", e.target.value); }}/>
                        </div>
                      );
                    })}
                    {hasSwings && (function() {
                      var filled = swingLog.filter(function(s) { return s.weight && s.reps; });
                      if (!filled.length) return null;
                      var vol = filled.reduce(function(a, s) { return a+(parseFloat(s.weight)||0)*(parseInt(s.reps)||0); }, 0);
                      return (
                        <div style={{ marginTop:8, display:"flex", gap:10 }}>
                          <div style={{ background:"#F5A6230e", border:"1px solid #F5A62322", borderRadius:5, padding:"5px 12px", flex:1, textAlign:"center" }}>
                            <div style={{ fontFamily:"monospace", fontSize:9, color:T.muted }}>VOLUME</div>
                            <div style={{ fontFamily:"monospace", fontSize:13, color:"#F5A623", fontWeight:700 }}>{vol.toLocaleString()} lbs</div>
                          </div>
                          <div style={{ background:"#F5A6230e", border:"1px solid #F5A62322", borderRadius:5, padding:"5px 12px", flex:1, textAlign:"center" }}>
                            <div style={{ fontFamily:"monospace", fontSize:9, color:T.muted }}>SETS</div>
                            <div style={{ fontFamily:"monospace", fontSize:13, color:"#F5A623", fontWeight:700 }}>{filled.length}/3</div>
                          </div>
                        </div>
                      );
                    })()}
                  </div>

                  {/* Forearm Plank */}
                  <div style={{ background:hasPlanks?(isDark?"#0a120e":"#efffef"):T.card, border:"1px solid "+(hasPlanks?"#22c55e44":T.border), borderRadius:8, marginBottom:8, padding:"14px 16px" }}>
                    <div style={{ display:"flex", alignItems:"center", gap:12, marginBottom:12 }}>
                      <div style={{ minWidth:28, height:28, borderRadius:"50%", background:"#00B38322", border:"1px solid #00B38344", display:"flex", alignItems:"center", justifyContent:"center", fontFamily:"monospace", fontSize:11, color:"#00B383", fontWeight:700 }}>PL</div>
                      <div>
                        <div style={{ fontWeight:600, fontSize:15, color:hasPlanks?"#22c55e":T.text }}>Forearm Plank</div>
                        <div style={{ fontSize:11, color:T.sub }}>Core Stabilizers · Obliques · Transverse Abdominis</div>
                      </div>
                    </div>
                    <div style={{ display:"grid", gridTemplateColumns:"52px 1fr", gap:"4px 8px", marginBottom:6 }}>
                      <div/><div style={{ fontFamily:"monospace", fontSize:9, color:T.muted, textAlign:"center" }}>HOLD TIME (seconds)</div>
                    </div>
                    {[0,1,2].map(function(setIdx) {
                      var s = plankLog[setIdx] || { time:"" };
                      var setDone = !!s.time;
                      return (
                        <div key={setIdx} style={{ display:"grid", gridTemplateColumns:"52px 1fr", gap:"4px 8px", marginBottom:6, alignItems:"center" }}>
                          <div style={{ fontFamily:"monospace", fontSize:10, color:setDone?"#22c55e":"#00B383", textAlign:"right", paddingRight:8 }}>SET {setIdx+1}</div>
                          <input type="number" style={Object.assign({}, inpStyle, { borderColor:setDone?"#22c55e33":T.border })} inputMode="numeric" placeholder="-- secs" value={s.time||""} onChange={function(e) { updateOptLog(plankKey, setIdx, "time", e.target.value); }}/>
                        </div>
                      );
                    })}
                    {hasPlanks && (function() {
                      var filled = plankLog.filter(function(s) { return s.time; });
                      if (!filled.length) return null;
                      var total = filled.reduce(function(a, s) { return a+(parseInt(s.time)||0); }, 0);
                      return (
                        <div style={{ marginTop:8, display:"flex", gap:10 }}>
                          <div style={{ background:"#00B3830e", border:"1px solid #00B38322", borderRadius:5, padding:"5px 12px", flex:1, textAlign:"center" }}>
                            <div style={{ fontFamily:"monospace", fontSize:9, color:T.muted }}>TOTAL TIME</div>
                            <div style={{ fontFamily:"monospace", fontSize:13, color:"#00B383", fontWeight:700 }}>{total}s</div>
                          </div>
                          <div style={{ background:"#00B3830e", border:"1px solid #00B38322", borderRadius:5, padding:"5px 12px", flex:1, textAlign:"center" }}>
                            <div style={{ fontFamily:"monospace", fontSize:9, color:T.muted }}>SETS</div>
                            <div style={{ fontFamily:"monospace", fontSize:13, color:"#00B383", fontWeight:700 }}>{filled.length}/3</div>
                          </div>
                        </div>
                      );
                    })()}
                  </div>
                </div>
              )}
            </div>
          );
        })()}
        <div style={{ marginTop:8, background:T.card, border:"1px solid "+T.border, borderRadius:8, padding:16 }}>
          <div style={{ fontFamily:"monospace", fontSize:10, color:T.muted, marginBottom:12 }}>WEEKLY MUSCLE FREQUENCY</div>
          <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fill,minmax(140px,1fr))", gap:8 }}>
            {[{m:"Chest",d:"Mon + Fri"},{m:"Triceps",d:"Mon + Fri"},{m:"Back",d:"Tue + Sat"},{m:"Biceps",d:"Tue + Sat"},{m:"Shoulders",d:"Thu + Mon"},{m:"Quads",d:"Wed + Sat"},{m:"Hamstrings",d:"Wed + Sat"},{m:"Glutes",d:"Wed + Sat"},{m:"Core",d:"Mon + Thu"}].map(function(it, i) {
              return (
                <div key={i} style={{ background:T.section, border:"1px solid "+T.border, borderRadius:5, padding:"8px 10px" }}>
                  <div style={{ fontSize:12, fontWeight:600, color:T.text, marginBottom:2 }}>{it.m}</div>
                  <div style={{ fontFamily:"monospace", fontSize:9, color:day.color, marginBottom:2 }}>2x/WEEK</div>
                  <div style={{ fontSize:10, color:T.muted }}>{it.d}</div>
                </div>
              );
            })}
          </div>
        </div>

        {/* Weekly Frequency */}
        <div style={{ marginTop:8, background:T.card, border:"1px solid "+T.border, borderRadius:8, padding:16 }}>
          <div style={{ fontFamily:"monospace", fontSize:10, color:T.muted, marginBottom:12 }}>WEEKLY MUSCLE FREQUENCY</div>
          <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fill,minmax(140px,1fr))", gap:8 }}>
            {[{m:"Chest",d:"Mon + Fri"},{m:"Triceps",d:"Mon + Fri"},{m:"Back",d:"Tue + Sat"},{m:"Biceps",d:"Tue + Sat"},{m:"Shoulders",d:"Thu + Mon"},{m:"Quads",d:"Wed + Sat"},{m:"Hamstrings",d:"Wed + Sat"},{m:"Glutes",d:"Wed + Sat"},{m:"Core",d:"Mon + Thu"}].map(function(it, i) {
              return (
                <div key={i} style={{ background:T.section, border:"1px solid "+T.border, borderRadius:5, padding:"8px 10px" }}>
                  <div style={{ fontSize:12, fontWeight:600, color:T.text, marginBottom:2 }}>{it.m}</div>
                  <div style={{ fontFamily:"monospace", fontSize:9, color:day.color, marginBottom:2 }}>2x/WEEK</div>
                  <div style={{ fontSize:10, color:T.muted }}>{it.d}</div>
                </div>
              );
            })}
          </div>
        </div>

        {/* Recovery Heatmap */}
        <RecoveryHeatmap isDark={isDark} liveLogs={logs} />

        {/* Sunday Note */}
        <div style={{ marginTop:16, background:T.section, border:"1px solid "+T.border, borderRadius:6, padding:"12px 16px", fontSize:12, color:T.muted, lineHeight:1.6 }}>
          <span style={{ fontFamily:"monospace", fontSize:9, color:T.muted, display:"block", marginBottom:4 }}>SUNDAY - REST & RECOVERY</span>
          Complete rest or light walking. Sermorelin peaks during deep sleep. Prioritize 7-9 hours. BPC-157 works systemically during rest.
        </div>

        {/* Weekly Volume */}
        {(function() {
          var vol = getWeeklyVolume();
          var entries = Object.entries(vol).sort(function(a, b) { return b[1] - a[1]; });
          if (!entries.length) return null;
          var maxVol = entries[0][1];
          var colorMap = { Chest:"#E8453C", Triceps:"#E8453C", Lats:"#2D7FF9", Back:"#2D7FF9", Biceps:"#2D7FF9", Brachialis:"#2D7FF9", Quads:"#00B383", Glutes:"#00B383", Hamstrings:"#00B383", Shoulders:"#F5A623", Core:"#9B59F5", Obliques:"#9B59F5" };
          return (
            <div style={{ marginTop:16, background:T.card, border:"1px solid "+T.border, borderRadius:8, padding:16 }}>
              <div style={{ display:"flex", alignItems:"center", justifyContent:"space-between", marginBottom:14 }}>
                <div style={{ fontFamily:"monospace", fontSize:10, color:T.muted }}>THIS WEEK'S VOLUME BY MUSCLE</div>
                <div style={{ fontFamily:"monospace", fontSize:9, color:T.faint }}>TOTAL: {entries.reduce(function(a, e) { return a + e[1]; }, 0).toLocaleString()} lbs</div>
              </div>
              {entries.map(function(entry) {
                var muscle = entry[0]; var v = entry[1];
                var pct = Math.round((v / maxVol) * 100);
                var barColor = "#555";
                Object.keys(colorMap).forEach(function(k) { if (muscle.indexOf(k) !== -1) barColor = colorMap[k]; });
                return (
                  <div key={muscle} style={{ marginBottom:8 }}>
                    <div style={{ display:"flex", justifyContent:"space-between", marginBottom:3 }}>
                      <span style={{ fontFamily:"monospace", fontSize:10, color:T.sub }}>{muscle}</span>
                      <span style={{ fontFamily:"monospace", fontSize:10, color:T.muted }}>{v.toLocaleString()} lbs</span>
                    </div>
                    <div style={{ height:4, background:T.section, borderRadius:2, overflow:"hidden" }}>
                      <div style={{ height:"100%", width:pct+"%", background:barColor, borderRadius:2 }}/>
                    </div>
                  </div>
                );
              })}
            </div>
          );
        })()}
      </div>
    </div>
  );
}
