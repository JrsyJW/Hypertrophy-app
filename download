      <span style={{ fontFamily:"monospace", fontSize:9, color: isDark ? "#505050" : "#999", letterSpacing:"0.12em", marginRight:10, userSelect:"none" }}>REST</span>
      {[30,60,90].map(function(s) {
        var active = visible && total === s;
        return (
          <button key={s} onClick={function() { start(s); }} style={{ background: active ? accentColor : "transparent", border:"1px solid "+(active ? accentColor : (isDark?"#2a2a2a":"#ccc")), borderRadius:20, color: active ? "#fff" : (isDark?"#6e6e6e":"#888"), fontFamily:"monospace", fontSize:11, fontWeight:700, padding:"5px 12px", cursor:"pointer", marginRight:4 }}>
            :{s < 10 ? "0" + s : s === 30 ? "30" : s === 60 ? "60" : "90"}
          </button>
        );
      })}
      {visible && (
        <div style={{ display:"flex", alignItems:"center", gap:8, marginLeft:6 }}>
          <svg width={26} height={26} style={{ transform:"rotate(-90deg)", flexShrink:0 }}>
            <circle cx={13} cy={13} r={R} fill="none" stroke={isDark?"#222":"#ddd"} strokeWidth={2.5}/>
            <circle cx={13} cy={13} r={R} fill="none" stroke={accentColor} strokeWidth={2.5} strokeDasharray={dash + " " + CIRC} strokeLinecap="round" style={{ transition:"stroke-dasharray .95s linear" }}/>
          </svg>
          <span style={{ fontFamily:"monospace", fontWeight:700, textAlign:"center", minWidth:26, fontSize: isCountdown ? 22 : 16, color: done ? "#22c55e" : isCountdown ? "#ff9500" : accentColor }}>
            {done ? "✓" : remaining}
          </span>
          {done && <span style={{ fontFamily:"monospace", fontSize:9, color:"#22c55e" }}>GO!</span>}
          <button onClick={cancel} style={{ background:"transparent", border:"1px solid "+(isDark?"#2a2a2a":"#ccc"), borderRadius:20, color: done ? "#22c55e" : (isDark?"#505050":"#888"), fontFamily:"monospace", fontSize:9, padding:"3px 8px", cursor:"pointer", marginLeft:2, fontWeight: done ? 700 : 400 }}>{done ? "RESET" : "X"}</button>
        </div>
      )}
    </div>
  );
}

